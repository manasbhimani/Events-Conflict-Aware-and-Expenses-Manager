# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/acm_incursion_db?schema=public"

# Next.js
NEXTPUBLIC_APP_URL="http://localhost:3000"

# Application timezone (informational - always store UTC in DB)
TZ_APP="Asia/Kolkata"

# Auth.js / NextAuth (Phase 2)
AUTH_SECRET="your-32-character-secret-generate-with-openssl-rand-hex-32"
# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional College Email Domain Restriction (e.g. @college.edu or college.edu)
ALLOWED_EMAIL_DOMAIN="@college.edu"

# Storage (Phase 5 - not needed yet)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
